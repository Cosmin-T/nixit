# Maintainer: Cosmin-T <120723446+Cosmin-T@users.noreply.github.com>
# nixit is a Linux fork of Mole (https://github.com/tw93/Mole) by tw93.

pkgname=nixit-git
_pkgname=nixit
pkgver=0.1.0.r0.g52aae80c
pkgrel=1
pkgdesc="Clean, uninstall, optimize, analyze and monitor Arch Linux from the terminal (Linux fork of Mole)"
arch=('x86_64' 'aarch64')
url="https://github.com/Cosmin-T/nixit"
license=('GPL-3.0-or-later')
depends=('bash' 'coreutils' 'findutils' 'fzf' 'gawk' 'glib2' 'glibc' 'pacman-contrib' 'procps-ng' 'sed' 'util-linux')
makedepends=('git' 'go')
optdepends=(
    'flatpak: uninstall Flatpak apps and remove unused runtimes'
    'pciutils: show GPU model names in status'
    'nvidia-utils: NVIDIA GPU usage in status'
    'xdg-utils: open files and folders from analyze'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+https://github.com/Cosmin-T/nixit.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$_pkgname"
    export GOPATH="$srcdir/gopath"
    go mod download -x > /dev/null 2>&1 || go mod download
}

build() {
    cd "$_pkgname"
    export GOPATH="$srcdir/gopath"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
    go build -ldflags "-linkmode=external" -o bin/analyze-go ./cmd/analyze
    go build -ldflags "-linkmode=external" -o bin/status-go ./cmd/status
}

check() {
    cd "$_pkgname"
    export GOPATH="$srcdir/gopath"
    export GOFLAGS="-mod=readonly -modcacherw"
    go test ./...
    bash tests/run.sh
}

package() {
    cd "$_pkgname"
    local lib="$pkgdir/usr/lib/$_pkgname"
    install -Dm755 nixit "$lib/nixit"
    install -Dm755 bin/clean.sh bin/uninstall.sh bin/optimize.sh bin/purge.sh \
        bin/analyze-go bin/status-go -t "$lib/bin/"
    install -Dm644 lib/common.sh -t "$lib/lib/"
    install -d "$pkgdir/usr/bin"
    ln -s "/usr/lib/$_pkgname/nixit" "$pkgdir/usr/bin/nixit"
    install -Dm644 README.md NOTICE -t "$pkgdir/usr/share/doc/$_pkgname/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
